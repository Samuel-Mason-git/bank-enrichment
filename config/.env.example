DASHBOARD_USER=admin
DASHBOARD_PASSWORD=yourpassword
TELEGRAM_API=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
# The Postgres database both the server and the pipeline use (the login
# data-vault's new_project.sh made for this project).
DB_HOST=your_database_private_ip
DB_PORT=5432
DB_NAME=vault
DB_USER=bank_enrichment
DB_PASSWORD=your_database_password
# The Ask page's agent reads through its own read-only login (data-vault's
# new_reader.sh bank_enrichment_agent bank_enrichment). Without it the Ask
# page is off: it never falls back to the login above.
AGENT_DB_USER=bank_enrichment_agent
AGENT_DB_PASSWORD=your_agent_database_password
# Optional, pipeline only: where "Back up now" saves its copies (default
# ~/bank-enrichment-backups) and where the log files go (default logs/).
# BACKUP_DIR=
# LOG_DIR=
CLAUDE_SECRET=your_claude_secret_key
MONZO_CLIENT_ID=your_monzo_oauth_client_id
MONZO_CLIENT_SECRET=your_monzo_oauth_client_secret
TELEGRAM_WEBHOOK_SECRET=generate_with_openssl_rand_hex_32
MONZO_WEBHOOK_SECRET=generate_with_openssl_rand_hex_32_a_different_value
